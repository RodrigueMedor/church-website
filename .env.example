# ====================
# Local Development
# ====================

# Frontend (used at build time by CRA)
REACT_APP_API_URL=http://localhost:8080

# Backend (used at runtime by docker-compose)
JWT_SECRET=change-me-to-a-random-base64-secret
DB_PASSWORD=church_pass

# ====================
# Production (DigitalOcean Droplet)
# ====================
# These are set in /opt/church-website/.env by setup-do.sh
# JWT_SECRET       = openssl rand -base64 32
# DB_PASSWORD      = openssl rand -base64 18
#
# CI/CD secrets needed in GitHub:
#   DO_HOST       - Droplet IP
#   DO_USER       - root
#   DO_SSH_KEY    - SSH private key (also a GitHub Deploy Key)
#   DOMAIN        - your domain (e.g. fhbck.org)
#   JWT_SECRET    - same as in .env
#   DB_PASSWORD   - same as in .env
